# Google OAuth 설정
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SECRET_KEY=

# PROD DB URL - used only when ENVIRONMENT=production
# For Supabase: postgresql+asyncpg://<USER>:<PASS>@db.<PROJECT>.supabase.co:5432/<DB_NAME>?sslmode=require
DATABASE_URL=

# DEV DB URL - default for non-production environments
# Example: postgresql+asyncpg://<USER>:<PASS>@db.<PROJECT>.supabase.co:5432/<DEV_DB_NAME>?sslmode=require
DEV_DATABASE_URL=

# TEST DB URL (used only when ENVIRONMENT=test). If unset, DEV_DATABASE_URL is used.
# Example: postgresql+asyncpg://<USER>:<PASS>@db.<PROJECT>.supabase.co:5432/<TEST_DB_NAME>?sslmode=require
TEST_DATABASE_URL=

# Database Pool (applied to PostgreSQL connections)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_PRE_PING=true
DB_POOL_RECYCLE=1800

# Environment Settings
ENVIRONMENT=development
ALLOWED_HOSTS=["localhost","127.0.0.1","*.yourdomain.com"]
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:3001","http://127.0.0.1:3001"]
CORS_ALLOW_METHODS=["GET","POST","PUT","PATCH","DELETE","OPTIONS"]
CORS_ALLOW_HEADERS=["Content-Type","Authorization","X-CSRF-Token","Idempotency-Key","X-Test-Now","X-AB-Participant-Token"]
# Frontend Redirect
AUTH_SUCCESS_URL=http://localhost:3000

# Google OAuth Additional Settings
GOOGLE_CONF_URL=https://accounts.google.com/.well-known/openid-configuration
GOOGLE_CLIENT_SCOPE=openid email profile

# Server Settings
HOST=0.0.0.0
PORT=8000

# Sentry - https://sentry.io/settings/<org>/projects/<project>/keys/
SENTRY_DSN=

# TypeSafe System One (JEV) — structured snippet scoring and Playbook safety gate

# 로그 파일 경로 (미설정 시 stdout만 출력)
LOG_FILE=logs/gcs-pulse-server.log

# A/B 실습 이미지 저장 경로 (기본값: apps/server/data/ab-practice)
# AB_PRACTICE_UPLOAD_DIR=/var/lib/gcs-pulse/ab-practice

# Rate Limits
LOGIN_LIMIT=5/minute
TERMS_LIMIT=60/minute
CONSENTS_LIMIT=10/minute
ME_LIMIT=20/minute
PROTECTED_LIMIT=10/minute
TOKENS_LIST_LIMIT=30/minute
TOKENS_WRITE_LIMIT=20/minute
TEAMS_WRITE_LIMIT=20/minute
USERS_LEAGUE_UPDATE_LIMIT=10/minute
MCP_HTTP_STREAM_LIMIT=30/minute  # /mcp GET (stream/connection)
MCP_HTTP_MESSAGES_LIMIT=120/minute  # /mcp POST,DELETE

# OpenAI Responses API
OPENAI_API_KEY=
OPENAI_GENERATION_MODEL=gpt-6.2-sol
OPENAI_SNIPPET_EVAL_MODEL=gpt-6-luna
OPENAI_PLAYBOOK_CONFIDENCE_THRESHOLD=0.80
OPENAI_PLAYBOOK_EVIDENCE_THRESHOLD=0.80
OPENAI_REQUEST_TIMEOUT=60
